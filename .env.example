# LocalLead AI — Environment Variables
# Copy this file to `.env.local` and fill in your credentials.
# Never commit .env.local to version control.

# ─── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Get from: Cloudflare Dashboard → Turnstile → Add site
# Test keys (always pass): sitekey=1x00000000000000000000AA, secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── App Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="LocalLead AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cloudflare D1 (via Wrangler) ────────────────────────────────────────────
# These are used by Wrangler CLI, NOT directly in Next.js runtime.
# Set CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in CI/CD secrets instead.
# D1_DATABASE_ID=your-d1-database-id-here

# ─── Overpass API (Optional: Custom endpoint override) ───────────────────────
# Leave blank to use the public mirrors (default round-robin in overpass.ts)
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# ─── Analytics (Optional) ────────────────────────────────────────────────────
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=your-cloudflare-analytics-token
